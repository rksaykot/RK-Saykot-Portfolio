{
  "name": "rk-saykot-portfolio",
  "private": true,
  "version": "2.0.0",
  "homepage": "https://rksaykot999.github.io/RK-Saykot-Portfolio/",
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"CLIENT,SERVER\" --prefix-colors \"cyan,yellow\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "cd server && npm run dev",
    "server": "cd server && npm start",
    "seed": "cd server && npm run seed",
    "build": "vite build && node -e \"import { copyFileSync } from 'fs'; copyFileSync('dist/index.html', 'dist/404.html')\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.22.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "react-type-animation": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.6",
    "cross-env": "^7.0.3",
    "daisyui": "^5.6.6",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.2",
    "vite": "^8.0.12"
  }
}
